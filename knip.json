{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/core/run-analyze.ts",
    "src/core/analyze.ts",
    "src/core/repo-detect.ts",
    "src/audit/cli.ts",
    "src/audit/ledger-cli.ts",
    "src/audit/backtest.ts",
